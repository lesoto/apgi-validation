# APGI Framework Environment Variables
# ===================================
# Copy this file to .env and customize for your environment

# Database Configuration
# --------------------
# APGI_DATABASE_URL=sqlite:///apgi_data.db
# APGI_DATABASE_HOST=localhost
# APGI_DATABASE_PORT=5432
# APGI_DATABASE_NAME=apgi_framework
# APGI_DATABASE_USER=apgi_user
# APGI_DATABASE_PASSWORD=your_password_here

# API Keys and External Services
# ---------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Logging Configuration
# -------------------
# APGI_LOG_LEVEL=INFO
# APGI_LOG_FILE=logs/apgi.log
# APGI_LOG_MAX_SIZE=10MB
# APGI_LOG_BACKUP_COUNT=5

# Performance Settings
# ------------------
# APGI_MAX_WORKERS=4
# APGI_TIMEOUT_SECONDS=300
# APGI_MEMORY_LIMIT_GB=8
# APGI_CACHE_SIZE_MB=1024

# Validation Protocol Settings
# ---------------------------
# APGI_VALIDATION_DATA_DIR=data/validation
# APGI_VALIDATION_RESULTS_DIR=results/validation
# APGI_VALIDATION_PARALLEL_RUNS=true
# APGI_VALIDATION_MAX_PARALLEL=2

# Falsification Protocol Settings
# -------------------------------
# APGI_FALSIFICATION_DATA_DIR=data/falsification
# APGI_FALSIFICATION_RESULTS_DIR=results/falsification
# APGI_FALSIFICATION_THRESHOLD_ALPHA=0.05
# APGI_FALSIFICATION_BOOTSTRAP_SAMPLES=1000

# Dashboard and Monitoring
# -----------------------
# APGI_DASHBOARD_PORT=8080
# APGI_DASHBOARD_HOST=localhost
# APGI_MONITORING_ENABLED=true
# APGI_METRICS_EXPORT_INTERVAL=60

# Development and Debugging
# ------------------------
# APGI_DEBUG=false
# APGI_VERBOSE_LOGGING=false
# APGI_PROFILE_PERFORMANCE=false
# APGI_ENABLE_TEST_MODE=false

# Security Settings
# ---------------
# APGI_SECRET_KEY=your_secret_key_here
# APGI_ENCRYPTION_KEY=your_encryption_key_here
# APGI_SSL_CERT_PATH=/path/to/cert.pem
# APGI_SSL_KEY_PATH=/path/to/key.pem

# File Paths and Directories
# -----------------------
# APGI_PROJECT_ROOT=/path/to/apgi/project
# APGI_CONFIG_DIR=config
# APGI_DATA_DIR=data
# APGI_OUTPUT_DIR=output
# APGI_TEMP_DIR=temp

# External Tool Paths
# ------------------
# APGI_MATLAB_PATH=/usr/local/bin/matlab
# APGI_RSCRIPT_PATH=/usr/local/bin/Rscript
# APGI_PYTHON_PATH=/usr/bin/python3

# Cloud Services (Optional)
# ------------------------
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-west-2
# AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
# GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id

# Experimental Features
# --------------------
# APGI_ENABLE_EXPERIMENTAL_FEATURES=false
# APGI_BETA_FEATURES_ENABLED=false
# APGI_ADVANCED_LOGGING=false

# Custom Environment Variables
# ---------------------------
# Add any custom variables your specific setup requires below:
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2
